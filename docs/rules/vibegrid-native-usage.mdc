### Complete Generated Usage Example
```tsx
import { TaskColumns, TaskStatusOptions } from '@repo/dataforge/column-configurations'

// Select columns to display
const SELECTED_COLUMNS: (keyof Task)[] = ['title', 'status', 'project', 'assignee', 'dueDate']
const columns = SELECTED_COLUMNS.map(key => TaskColumns[key])

// Relationship data for dropdowns
const relationshipData: RelationshipDataProvider = {
  project: { data: projects, displayField: 'name' },
  assignee: { data: users, displayField: 'name' }
}

// Save handler
const handleSave = async (entityId: string, columnId: string, value: any) => {
  if (columnId === 'project') {
    await taskActions.updateTask(entityId, { projectId: value })
  } else if (columnId === 'assignee') {
    await taskActions.updateTask(entityId, { assigneeId: value })
  } else {
    await taskActions.updateTask(entityId, { [columnId]: value })
  }
}

// Render
<VibeGridNative
  data={tasks}
  columns={columns}
  relationshipData={relationshipData}
  onSave={handleSave}
  enablePagination={true}
  pageSize={10}
/>
```

## Manual Column Definitions (Alternative)

If you need custom column behavior, you can still define columns manually:

## Basic Setup

```tsx
import { VibeGridNative, type RelationshipDataProvider } from '@/components/custom/vibegridnative/components/VibeGridNative'
import type { ColumnDef } from '@tanstack/react-table'
```

## Column Definitions with Meta Configuration

The key is using the `meta` property to configure cell behavior:

```tsx
const columns: ColumnDef<YourEntity>[] = [
  // Text cell
  {
    id: 'title',
    accessorKey: 'title',
    header: 'Title',
    size: 200,
    meta: {
      cellType: 'text',
      config: {
        editable: true,
        placeholder: 'Enter title...',
        maxLength: 100
      }
    }
  },

  // Enum cell with dropdown
  {
    id: 'status',
    accessorKey: 'status', 
    header: 'Status',
    size: 120,
    meta: {
      cellType: 'enum',
      config: {
        editable: true,
        enumValues: {
          'open': 'Open',
          'in_progress': 'In Progress', 
          'completed': 'Completed'
        }
      }
    }
  },

  // Relationship cell (single)
  {
    id: 'project',
    accessorKey: 'project',
    header: 'Project',
    size: 150,
    meta: {
      cellType: 'relationship-single',
      config: {
        editable: true,
        displayField: 'name'
      }
    }
  },

  // System field (read-only)
  {
    id: 'id',
    accessorKey: 'id',
    header: 'ID',
    size: 120,
    meta: {
      cellType: 'uuid',
      systemField: true // Makes it read-only
    }
  }
]
```

## Relationship Data Provider

For relationship columns, provide dropdown options:

```tsx
const relationshipData: RelationshipDataProvider = {
  project: {
    data: projects, // Array of project objects
    displayField: 'name' // Field to show in dropdown
  },
  assignee: {
    data: users,
    displayField: 'name'
  }
}
```

## Save Handler

Handle data persistence when cells are edited:

```tsx
const handleSave = async (entityId: string, columnId: string, value: any) => {
  // Convert relationship updates
  if (columnId === 'project') {
    await updateEntity(entityId, { projectId: value })
  } else if (columnId === 'assignee') {
    await updateEntity(entityId, { assigneeId: value })
  } else {
    await updateEntity(entityId, { [columnId]: value })
  }
}
```

## Complete Component Usage

```tsx
<VibeGridNative
  data={entities}
  columns={columns}
  relationshipData={relationshipData}
  onSave={handleSave}
  
  // Optional configuration
  enableSorting={true}
  enablePagination={true}
  enableHorizontalScrolling={true}
  pageSize={25}
  pageSizeOptions={[10, 25, 50, 100]}
  
  // External state control (optional)
  pagination={paginationState}
  onPaginationChange={setPaginationState}
  
  // Styling
  className="border rounded-lg"
  debugMode={false}
/>
```

## Supported Cell Types

| Cell Type | Description | Config Options |
|-----------|-------------|----------------|
| `text` | Text input | `placeholder`, `maxLength`, `inputType` |
| `number` | Number input | `numberMin`, `numberMax`, `step` |
| `boolean` | Checkbox | - |
| `date` | Date picker | `showTime` |
| `enum` | Dropdown select | `enumValues` object |
| `uuid` | Read-only UUID (shows last 8 chars) | - |
| `json` | JSON display | - |
| `relationship-single` | Single relationship dropdown | `displayField` |
| `relationship-multi` | Multiple relationships | `displayField` |

