{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "useDefineForClassFields": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@/systems/vibegrid/*": ["src/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "bridge"],
  "exclude": ["node_modules", "dist", "archive", "reference", "harness", "e2e"]
}
